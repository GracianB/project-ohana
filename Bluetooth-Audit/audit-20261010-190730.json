}\n probe.preload='metadata';probe.onloadedmetadata=()=>finish(true);probe.onerror=()=>finish(false);probe.src=url;}\n $('video-file').addEventListener('change',inspect);clear.addEventListener('click',()=>{if(state.busy)return;$('video-file').value='';$('video-file').dispatchEvent(new Event('change'));$('video-file').click();});$('upload-form').addEventListener('submit',event=>{if(checking||error){event.preventDefault();event.stopImmediatePropagation();notify(error||'Espera a que se lea el archivo.',true);}},{capture:true});\n $('youtube-submit').closest('form').addEventListener('submit',event=>{let valid=false;try{const url=new URL($('youtube-url').value);valid=url.protocol==='https:'&&(['youtube.com','www.youtube.com','m.youtube.com','youtu.be'].includes(url.hostname))&&(url.hostname==='youtu.be'?url.pathname.length>1:((url.pathname==='/watch'&&url.searchParams.has('v'))||/^\\\\/(shorts|live)\\\\/[^/]+/.test(url.pathname)));}catch{}if(!valid){event.preventDefault();event.stopImmediatePropagation();notify('Pega el enlace HTTPS de un vídeo, Short o directo de YouTube.',true);}},{capture:true});\n const previousBusy=setBusy;setBusy=function(value){previousBusy(value);$('upload').disabled=value||checking||Boolean(error);clear.disabled=value;};\n})();\n''',encoding='utf-8')\np=Path('web/index.html');p.write_text(p.read_text(encoding='utf-8').replace('</head>','<script src=\\\"/studio-import.js?v=product-12\\\" defer></script></head>'),encoding='utf-8')\np=Path('.github/workflows/quality.yml');p.write_text(p.read_text(encoding='utf-8')+'      - run: node --check web/studio-import.js\\n',encoding='utf-8')\n'@ | python -\nnode --check web/studio-import.js\npython C:\\Users\\Juncho\\Documents\\Codex\\2026-10-07\\es\\publish-cutter-pr.py 7 \\\"Importación con metadatos y validación previa\\\" \\\"Muestra tamaño y duración del archivo antes de enviarlo; evita archivos vacíos o que superan los límites. Si el navegador no puede leer la duración, permite comprobarla en el motor